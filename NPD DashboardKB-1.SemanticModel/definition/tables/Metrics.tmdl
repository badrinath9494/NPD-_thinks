	measure Completed_parts_status = ```
			
			var daysbet = DATEDIFF(MAX('Completed Particulars Details'[Plan]) , MAX('Completed Particulars Details'[Actual]),DAY)
			var dayTod = DATEDIFF(MAX('Completed Particulars Details'[Plan]), TODAY(), DAY)
			return IF(ISBLANK(MAX('Completed Particulars Details'[Plan])),
			    BLANK(),
			    IF( MAX('Completed Particulars Details'[Plan]) < TODAY() && ISBLANK(MAX('Completed Particulars Details'[Actual])),
			        CONCATENATE(dayTod," Days Delayed"),
			        IF(
			            daysbet <= 0, 
			            BLANK(), 
			            CONCATENATE(daysbet, " Days Delayed")
			        )
			    )
			)
			```
		lineageTag: fc1c12f0-4e29-40ec-a11f-127eca326da9

