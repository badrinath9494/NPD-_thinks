	measure Completed_bg_status =
			
			IF(ISBLANK(MAX('Completed Particulars Details'[Plan])),
			    BLANK(),
			    IF( NOT(ISBLANK(MAX('Completed Particulars Details'[Actual]))),
			        "#35AD3F",
			        IF( MAX('Completed Particulars Details'[Plan]) < TODAY() && ISBLANK(MAX('Completed Particulars Details'[Actual])),
