	measure PlanFontColor = ```
			
			VAR CurrentMonthText = SELECTEDVALUE('ProtoMonthPlan'[MonthYearFormatted])
			
			-- Convert text to date handling 2-digit or 4-digit year
			VAR ParsedDate =
			    IF (
			        LEN(TRIM(CurrentMonthText)) > 7,  -- Assume format "MMM, YYYY"
			        DATEVALUE("01 " & CurrentMonthText),
			        -- else 2-digit year, like "June, 25"
			        DATEVALUE("01 " & LEFT(CurrentMonthText, LEN(CurrentMonthText)-3) & " 20" & RIGHT(CurrentMonthText, 2))
			    )
			
			-- Previous month date
			VAR PrevMonthDate = EOMONTH(ParsedDate, -1)
			
			-- Format back to "MMMM, YYYY"
			VAR PrevMonthText = FORMAT(PrevMonthDate, "MMMM, yyyy")
			
			-- Check if previous month has Plan <> Actual mismatch
			VAR HasMismatch =
			    CALCULATE(
			        COUNTROWS('ProtoMonthPlan'),
			        FILTER(
			            'ProtoMonthPlan',
			            'ProtoMonthPlan'[MonthYearFormatted] = PrevMonthText &&
			            NOT(ISBLANK('ProtoMonthPlan'[Plan])) &&
			            NOT(ISBLANK('ProtoMonthPlan'[Actual])) &&
			            'ProtoMonthPlan'[Plan] <> 'ProtoMonthPlan'[Actual]
			        )
			    )
			
			RETURN
			IF(HasMismatch > 0, "#FFFF00", "#000000")
			
			
			
			
			
			```
		formatString: 0
		lineageTag: 24156891-84d8-4762-84e3-dacce5880c32

	measure PlanVsActualFontColor = ```
			
			VAR PlanValue = SELECTEDVALUE(ProtoMonthPlan[Plan])
			VAR ActualValue = SELECTEDVALUE(ProtoMonthPlan[Actual])
			
			RETURN
			IF (
			    ISBLANK(ActualValue) || ISBLANK(PlanValue),
			    "#000000",  -- black if data missing
			    IF(ActualValue < PlanValue, "#FF0000", "#008000")  -- red or green
			)
			
			```
		lineageTag: 1a6fbe90-80ba-4f98-b746-2f85c9143f9c

	measure PlanHighlightNextMonth = ```
			
			VAR CurrentDate = SELECTEDVALUE(ProtoMonthPlan[MonthYearFormatted])
			VAR CurrentPart = SELECTEDVALUE(ProtoMonthPlan[Part Number])
			VAR PrevMonth = EOMONTH(CurrentDate, -1)
			
			-- Check for mismatch for the same Part Number in the previous month
			VAR HasMismatch =
			    CALCULATE(
			        COUNTROWS(ProtoMonthPlan),
			        FILTER(
			            ALL(ProtoMonthPlan),
			            ProtoMonthPlan[Part Number] = CurrentPart &&
			            EOMONTH(ProtoMonthPlan[MonthYearFormatted], 0) = PrevMonth &&
			            NOT(ISBLANK(ProtoMonthPlan[Plan])) &&
			            NOT(ISBLANK(ProtoMonthPlan[Actual])) &&
			            ProtoMonthPlan[Plan] <> ProtoMonthPlan[Actual]
			        )
			    )
			
			RETURN
			IF(HasMismatch > 0, "#FFFF00", "#000000")
			
			
			
			```
		lineageTag: 6441f04b-bf17-4d20-9b8c-f18e81861087

