	measure status = ```
			
			var daysbet = DATEDIFF(MAX(Particulars[Plan]) , MAX(Particulars[Actual]),DAY)
			var dayTod = DATEDIFF(MAX(Particulars[Plan]), TODAY(), DAY)
			return IF(ISBLANK(MAX(Particulars[Plan])),
			    BLANK(),
			    IF( MAX(Particulars[Plan]) < TODAY() && ISBLANK(MAX(Particulars[Actual])),
			        CONCATENATE(dayTod," Days Delayed"),
			        IF(
			            daysbet <= 0, 
			            BLANK(), 
			            CONCATENATE(daysbet, " Days Delayed")
			        )
			    )
			)
			```
		lineageTag: d164e098-aba2-49db-9ce1-60e9b0bce099

