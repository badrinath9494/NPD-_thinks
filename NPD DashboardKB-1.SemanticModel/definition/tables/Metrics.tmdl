	measure Overdue_Not_Completed_Percentage = ```
			
			VAR OverdueCount = 
			    CALCULATE(
			        COUNTROWS('Action_Plan'),  
			        'Action_Plan'[When] < TODAY(),  
			        OR(
			            ISBLANK('Action_Plan'[Status]),  
			            'Action_Plan'[Status] = "Not Completed"  
			        )
			    )
			
			VAR TotalCount = COUNTROWS('Action_Plan')
			
			RETURN 
			IF(TotalCount = 0, BLANK(), DIVIDE(OverdueCount, TotalCount, 0))
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e6d3e837-e3dc-4191-b56c-f560660d29a0

	measure Status_Not_Updated_Count = ```
			
			VAR NotUpdatedCount =
			    CALCULATE(
			        COUNTROWS('Action_Plan'),
			        FILTER(
			            'Action_Plan',
			            NOT(ISBLANK('Action_Plan'[When])) &&
			            'Action_Plan'[When] <= TODAY() &&
			            (
			                ISBLANK('Action_Plan'[Status]) ||
			                'Action_Plan'[Status] = "Not Completed"
			            )
			        )
			    )
			RETURN
			    COALESCE(NotUpdatedCount, 0)
			
			
			
			```
		formatString: 0
		lineageTag: 6f329fc3-e3ed-487b-83e3-228233ed5b8e

	measure Top_Overdue_Person = ```
			
			VAR SummaryTable = 
			    SUMMARIZE(
			        FILTER(
			            'Action_Plan',
			            'Action_Plan'[When] < TODAY() &&
			            (ISBLANK('Action_Plan'[Status]) || 'Action_Plan'[Status] = "Not Completed")
			        ),
			        'Action_Plan'[Who], 
			        "Overdue Count", COUNTROWS('Action_Plan')
			    )
			
			VAR TopPerson = 
			    TOPN(1, SummaryTable, [Overdue Count], DESC)
			
			RETURN
			    MAXX(TopPerson, 'Action_Plan'[Who])  
			```
		lineageTag: 2eb026c9-ef23-4b5e-a0b3-e0601d88edb0

