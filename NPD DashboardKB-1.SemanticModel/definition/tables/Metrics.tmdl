	measure Top5_Delayed_Activities = ```
			
			VAR PlanDate = MAX(ProtoActivity[Plan])
			VAR ActualDate = MAX(ProtoActivity[Actual])
			VAR DelayDays =
			    IF(
			        ISBLANK(ActualDate) && NOT(ISBLANK(PlanDate)) && PlanDate < TODAY(),
			        DATEDIFF(PlanDate, TODAY(), DAY),
			        BLANK()
			    )
			VAR RankMeasure =
			    RANKX(
			        FILTER(
			            ALL(ProtoActivity[Part Number], ProtoActivity[Particular]),
			            ISBLANK(CALCULATE(MAX(ProtoActivity[Actual]))) &&
			            NOT(ISBLANK(CALCULATE(MAX(ProtoActivity[Plan]))))
			        ),
			        CALCULATE(DATEDIFF(MAX(ProtoActivity[Plan]), TODAY(), DAY)),
			        ,
			        DESC,
			        DENSE
			    )
			RETURN
			    IF(RankMeasure <= 5, DelayDays, BLANK())
			
			
			
			
			
			
			
			
			```
		formatString: 0
		lineageTag: 94e047e3-7982-44d8-a15a-ed21098f11fc

