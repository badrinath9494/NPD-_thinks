	measure 'Top At-Risk Resp' = ```
			
			VAR SummaryTable =
			    ADDCOLUMNS(
			        SUMMARIZE('Action_plan-1', 'Action_plan-1'[Resp]),
			        "NotGreenCount",
			        CALCULATE(
			            COUNTROWS('Action_plan-1'),
			            'Action_plan-1'[Status] <> "G",
			            'Action_plan-1'[Revised Commitment date] <= TODAY()
			        )
			    )
			VAR MaxCount =
			    MAXX(SummaryTable, [NotGreenCount])
			VAR TopResps =
			    FILTER(SummaryTable, [NotGreenCount] = MaxCount)
			RETURN
			    CONCATENATEX(TopResps, 'Action_plan-1'[Resp], ", ")
			
			
			
			
			
			```
		lineageTag: cdd4a1d8-a57c-4d8e-ab34-b35a681e8d17

	measure 'Top At-Risk Dept' = ```
			
			VAR SummaryTable =
			    ADDCOLUMNS(
